run() {
  local instruction="$1"
  local dynamic_context="$2"
  local model="${3:-}"
  local dynamic_cmds="${4:-}"
  shift 4 || true

  local files
  files=$(existing_files "$@")

  if [ -z "$files" ]; then
    echo "Error: No valid context files found"
    exit 1
  fi

  # Execute dynamic commands and capture output into context (live mode only)
  if [ -n "$dynamic_cmds" ] && [ "$DRY_RUN" = false ]; then
    local dynamic_cmd_output
    dynamic_cmd_output=$(eval "$dynamic_cmds" 2>&1 || true)
    if [ -n "$dynamic_cmd_output" ]; then
      dynamic_context="$dynamic_context

### COMMAND OUTPUT
\`\`\`
$dynamic_cmd_output
\`\`\`"
    fi
  fi

  # Get relative file paths for display
  local files_display
  files_display=$(echo "$files" | sed "s|$REPO_ROOT/||g" | tr '\n' ' ')

  local static_context
  static_context="$(cat $files 2>/dev/null || true)"

  local full_prompt="
  ### TASK
  $instruction

  ### STATIC CONTEXT
  $static_context

  ### DYNAMIC CONTEXT
  $dynamic_context

  ### USER REQUEST
  $PROMPT
  "

  # Prompt without static context (for dry-run display)
  local prompt_no_static="
  ### TASK
  $instruction

  ### DYNAMIC CONTEXT
  $dynamic_context

  ### USER REQUEST
  $PROMPT
  "

  run_ai "$full_prompt" "$model" "$files_display" "$prompt_no_static" "$dynamic_cmds"
}

# --deep: runs $instruction 3 times in parallel, each restricted to a
# different review lens, then a final pass that cross-checks all three
# against the actual diff and only writes findings that survive.
DEEP_LENSES=(
  "correctness and bugs"
  "security vulnerabilities (OWASP top 10, injection, auth, secrets)"
  "performance, code quality, and adherence to project conventions in docs/"
)

run_deep_review() {
  local instruction="$1"
  local dynamic_context="$2"
  local model="$3"
  local dynamic_cmds="$4"
  shift 4 || true

  local tmp_dir
  tmp_dir=$(mktemp -d "$AI_PRIVATE_DIR/.deep-review-XXXXXX")
  # Also trap EXIT: run() calls `exit` (not `return`) when a required context
  # file is missing, which would otherwise skip this cleanup and leave the
  # tmp dir behind. The path is expanded now (double quotes), not deferred,
  # so the trap still has it after this function's local $tmp_dir is gone —
  # otherwise a later EXIT (e.g. at the end of the whole script) would trip
  # `set -u` trying to read an out-of-scope local. Harmless to fire both —
  # rm -rf on an already-removed dir is a no-op.
  trap "rm -rf '$tmp_dir'" RETURN EXIT

  echo "Deep review: running ${#DEEP_LENSES[@]} independent lenses in parallel..."

  # $COMMAND (audit/review) is already a PLAN_MODE_COMMAND, so every lens
  # sub-pass below and the final verification pass both run in real
  # read-only plan mode structurally, not just via the "report only"
  # wording. Lens sub-passes set SUPPRESS_CAPTURE=true (isolated to their own
  # subshell/background job, so it's safe under parallel execution) so their
  # output is only captured into the tmp file by shell redirection, not
  # auto-saved to REVIEW.md — only the final merged pass below saves there.
  local pids=()
  local i=0
  for lens in "${DEEP_LENSES[@]}"; do
    i=$((i + 1))
    (
      SUPPRESS_CAPTURE=true
      run "$instruction Focus this pass exclusively on: $lens. Do NOT modify, fix, or refactor any source file in this pass, even if the base instruction above says otherwise — report only. Present your findings as your response text only; this sub-pass is not saved automatically, a later pass merges it." \
        "$dynamic_context" "$model" "$dynamic_cmds" "$@" \
        > "$tmp_dir/lens-$i.md" 2>&1
    ) &
    pids+=("$!")
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done

  echo "Deep review: verifying findings against the diff and merging..."

  local combined=""
  for f in "$tmp_dir"/lens-*.md; do
    combined="$combined

### LENS: $(basename "$f")
$(cat "$f")"
  done

  run "Below are ${#DEEP_LENSES[@]} independent review passes over the same changes, each from a different angle, run blind to each other. 1) Cross-check every finding against the actual diff/code — discard anything that doesn't hold up on a second look, is speculative, or isn't actually present in the changes. 2) Merge duplicate findings reported by more than one lens into one. 3) This is a read-only pass — you have no access to write files or run mutating tools, so present ONLY the findings that survive this check directly in your response, grouped by severity, noting which lens(es) originally found each one; it will be saved automatically to $AI_PRIVATE_DIR/REVIEW.md (overwriting any previous content). A plain 'fix' run afterwards is what applies the fixes." \
    "$combined" \
    "$model" \
    "" \
    "$@"
}

dispatch_command() {
case "$COMMAND" in
  chat)
    run_ai "$PROMPT"
    ;;

  audit)
    require_files "$BUG_HUNTING"
    audit_instruction="1) Review the current source-control changes (staged, unstaged, and against $BASE_BRANCH) against the criteria in $AI_PRIVATE_DIR/BUG-HUNTING.md. 2) Identify bugs, inefficiencies, and unclear code introduced by these changes. 3) Avoid modifying or refactoring code external to this branch's changes against $BASE_BRANCH. 4) This is a read-only pass — you have no access to write files or run mutating tools, so present your findings directly in your response, grouped by severity; it will be saved automatically to $AI_PRIVATE_DIR/REVIEW.md (overwriting any previous content)."
    if [ "$DEEP" = true ]; then
      run_deep_review "$audit_instruction" \
        "$(refactor_context)" \
        "sonnet" \
        "" \
        "$BUG_HUNTING"
    else
      run "$audit_instruction" \
        "$(refactor_context)" \
        "sonnet" \
        "" \
        "$BUG_HUNTING"
    fi
    ;;

  debug)
    require_files "$BASE" "$DEBUG"
    run "1) Root cause analysis, 2) Minimal reproduction steps, 3) Smallest safe fix with code changes (as a diff/snippet in your response — you have no access to write files or run mutating tools in this pass), 4) Regression tests to prevent recurrence, 5) Present findings directly in your response, grouped by severity; it will be saved automatically to $AI_PRIVATE_DIR/REVIEW.md (overwriting any previous content).$(html_task_instruction_inline)" \
      "$(debug_context)" \
      "opus" \
      "" \
      "$BASE" "$DEBUG"
    ;;

  feature)
    if [ ! -f "$PLANNING" ]; then
      echo "Error: $PLANNING not found."
      echo "Create it with your feature description. Note: this command now uses PLANNING.md (previously FEATURE.md)."
      exit 1
    fi
    require_files "$BASE"
    run "1) Implement the feature specified in $AI_PRIVATE_DIR/PLANNING.md. 2) Follow project conventions in $REPO_ROOT/docs. 3) Write clean, tested code matching existing patterns. 4) Create or update unit tests. $PATH_NOTE" \
      "$(feature_context)" \
      "" \
      "" \
      "$BASE" "$PLANNING"
    ;;

  refactor)
    require_files "$BASE" "$REVIEW"
    run "1) Apply the refactoring described in $AI_PRIVATE_DIR/REVIEW.md. 2) Preserve existing behavior while improving code quality. 3) Follow project conventions in $REPO_ROOT/docs. 4) Ensure all tests pass. 5) Create a refactoring summary inside $AI_PRIVATE_DIR/REFACTOR.md (if exists, overwrite). $PATH_NOTE" \
      "$(refactor_context)" \
      "" \
      "" \
      "$BASE" "$REVIEW"
    ;;

  review)
    require_files "$BASE" "$REVIEW"
    review_instruction="1) Review changed files against $BASE_BRANCH. 2) Check for: bugs, style violations (per docs/), missing tests, performance issues, security concerns.$(skill_hint 'Use the security-review skill for the security-concerns dimension.') 3) Follow project conventions in $REPO_ROOT/docs and keep in mind $AI_PRIVATE_DIR/LEARNED.md doc about old reviews. 4) This is a read-only pass — you have no access to write files or run mutating tools, so present your findings directly in your response, with actionable suggestions grouped by severity; it will be saved automatically to $AI_PRIVATE_DIR/REVIEW.md (overwriting any previous content).$(html_task_instruction_inline)"
    if [ "$DEEP" = true ]; then
      run_deep_review "$review_instruction" \
        "$(review_context)" \
        "" \
        "" \
        "$BASE" "$REVIEW"
    else
      run "$review_instruction" \
        "$(review_context)" \
        "" \
        "" \
        "$BASE" "$REVIEW"
    fi
    ;;

  planning)
    require_files "$BASE" "$PLANNING"
    run "1) Create an implementation plan from the custom prompt. 2) This is a read-only planning pass — you have no access to write files or run mutating tools, so don't attempt to; just present the complete plan directly in your response, it will be saved automatically. 3) Output: a) Architecture overview, b) Files to create/modify, c) Risks and mitigations, d) Implementation order, e) Test strategy.$(html_task_instruction_inline)" \
      "$(planning_context)" \
      "opus" \
      "" \
      "$BASE" "$PLANNING"
    ;;

  fix)
    require_files "$BASE" "$REVIEW"
    run "1) Fix the bugs and improvements from $AI_PRIVATE_DIR/REVIEW.md. 2) Follow project conventions in $REPO_ROOT/docs. 3) Avoid modifying or refactoring code external to this branch changes against $BASE_BRANCH." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$BASE" "$REVIEW"
    ;;

  suggestions)
    require_files "$BASE"
    pr_info=$(gh pr view --json number,url,title 2>/dev/null || echo "No open PR found")
    run "1) Use github mcp to get the fix suggestions comments from this branch PR. 2) Create a fix plan based on the suggestions. 3) Write into $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite). 4) Ensure all tests pass. $PATH_NOTE" \
      "$(review_context)

### CURRENT PR
$pr_info" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  commit)
    require_files "$BASE"
    run "1) Generate a concise, semantic commit message for the staged changes. 2) Format: <type>(<scope>): <description>. 3) Types: feat, fix, refactor, docs, test, chore. 4) Return ONLY the commit message, nothing else." \
      "$(git diff --cached)" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  pr)
    require_files "$BASE"
    run "1) Generate a PR description for the changes in this branch against $BASE_BRANCH. 2) Include: Summary, Changes made, Testing done. 3) Use markdown formatting." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  test)
    require_files "$BASE"
    run "1) Analyze the test output. 2) Focus on the root cause, not just making tests pass. 3) Suggest fixes. $PATH_NOTE" \
      "$(review_context)" \
      "sonnet" \
      "npm run test" \
      "$BASE"
    ;;

  types)
    require_files "$BASE"
    run "1) Fix TypeScript errors in the changed files. 2) Do not use 'any' - use \$TSFixMe with a comment if truly unavoidable. 3) Follow project conventions." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  lint)
    require_files "$BASE"
    run "1) Analyze the lint output and fix ESLint and Prettier issues in the changed files. 2) Follow project style conventions." \
      "$(review_context)" \
      "sonnet" \
      "npm run check 2>&1 || true" \
      "$BASE"
    ;;

  playwright)
    require_files "$BASE"
    run "1) Analyze the Playwright E2E test output to identify failures introduced by this branch. 2) Compare changed files against $BASE_BRANCH to determine if failures are related to branch changes. 3) For each failure: identify root cause, affected component, and suggest a fix. 4) If mocks are stale or API responses changed, note which HAR files need updating.$(skill_hint 'Use the update-playwright-mocks skill to actually update them, one test at a time.') 5) This is a read-only pass — you have no access to write files or run mutating tools, so present findings directly in your response, with actionable fixes grouped by severity; it will be saved automatically to $AI_PRIVATE_DIR/REVIEW.md." \
      "$(playwright_context)" \
      "sonnet" \
      "npm run playwright 2>&1 || true" \
      "$BASE"
    ;;

  explain)
    require_files "$BASE"
    run "1) Explain the code, architecture, or pattern. 2) Be concise but thorough. 3) Include relevant file references." \
      "$(feature_context)" \
      "opus" \
      "" \
      "$BASE"
    ;;

  *)
    usage
    exit 1
    ;;
esac
}

if [ "${#CHAIN_STEPS[@]}" -gt 0 ]; then
  total="${#CHAIN_STEPS[@]}"
  for i in "${!CHAIN_STEPS[@]}"; do
    COMMAND="${CHAIN_STEPS[$i]}"
    echo ""
    echo "▶ Chain step $((i + 1))/$total: $COMMAND"
    dispatch_command
    is_last=$([ "$((i + 1))" -eq "$total" ] && echo true || echo false)
    if [ "$CHAIN_YES" != true ] && [ "$is_last" != true ] && [ "$DRY_RUN" = false ]; then
      read -r -p "Continue to next step ($((i + 2))/$total: ${CHAIN_STEPS[$((i + 1))]})? [y/N] " reply
      if [[ ! "$reply" =~ ^[Yy]$ ]]; then
        echo "Chain stopped by user after '$COMMAND'."
        exit 0
      fi
    fi
  done
else
  dispatch_command
fi