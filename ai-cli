REFACTOR="$AI_PRIVATE_DIR/REFACTOR.md"
REVIEW="$AI_PRIVATE_DIR/REVIEW.md"
PLANNING="$AI_PRIVATE_DIR/PLANNING.md"
BUG_HUNTING="$AI_PRIVATE_DIR/BUG-HUNTING.md"

require_files() {
  for file in "$@"; do
    if [ ! -f "$file" ]; then
      echo "Warning: Missing file $file (skipped)"
    fi
  done
}

existing_files() {
  for file in "$@"; do
    [ -f "$file" ] && echo "$file"
  done
}

# Reusable instruction for HTML task visualization. Every command that
# supports --planning now runs in plan mode (see PLAN_MODE_COMMANDS below),
# so the model never has file-write access when this instruction is used —
# it always emits the HTML inline as a fenced ```html code block instead,
# which write_captured_output() (below) splits out into its own file
# afterwards. Earlier version used a bare "###MARKER###" sentinel instead of
# a normal code fence — tested directly, a model asked to emit an arbitrary
# sentinel string with no framing read it as a prompt-injection attempt and
# refused. A ```html fence is a completely ordinary thing to ask for, so it
# doesn't trip that same instinct, and it's what write_captured_output looks
# for.
html_task_instruction_inline() {
  if [ "$PLANNING_HTML" != "true" ]; then
    echo ""
    return
  fi
  echo "Also produce a clean, interactive, professional HTML/CSS/JS self-contained infographic summarizing the above (layout, colors, filters, charts). You have no access to write files in this pass, so output the complete HTML as the very last thing in your response, as a single fenced code block starting with \`\`\`html on its own line and ending with a closing \`\`\` on its own line, with nothing after it."
}

# Commands that are structurally report-only (never modify source files, by
# design) run in each provider's real plan mode instead of the usual
# skip-permissions/allow-all flags — those flags were confirmed (by direct
# testing) to silently override plan mode and let the model edit files
# anyway, so they must not be combined with it. Since the model then has no
# ability to write files itself, ai-cli captures the printed response and
# saves it to whatever file that command would otherwise have asked the
# model to write (see capture_target_for_command / write_captured_output).
PLAN_MODE_COMMANDS=("planning" "review" "audit" "debug" "playwright" "explain")

is_plan_mode_command() {
  local cmd="$1" c
  for c in "${PLAN_MODE_COMMANDS[@]}"; do
    [ "$c" = "$cmd" ] && return 0
  done
  return 1
}

# Where a plan-mode command's captured output should be auto-saved, if
# anywhere. Empty means "print only, don't save to a file" — e.g. explain
# (which never wrote to a file even before plan mode existed), or a --deep
# lens sub-pass (SUPPRESS_CAPTURE=true; its output is merged by a later pass
# instead, see run_deep_review).
capture_target_for_command() {
  if [ "$SUPPRESS_CAPTURE" = true ]; then
    echo ""
    return
  fi
  case "$1" in
    planning) echo "$PLANNING" ;;
    review|audit|debug|playwright) echo "$REVIEW" ;;
    *) echo "" ;;
  esac
}

# Writes a plan-mode response to $target_file (no-op if empty), splitting
# out an inline ```html fenced block (see html_task_instruction_inline) into
# its own timestamped file if present.
write_captured_output() {
  local output="$1"
  local target_file="$2"
  if [ -z "$target_file" ]; then
    return
  fi
  if ! grep -qE '^```html[[:space:]]*$' <<< "$output"; then
    echo "$output" > "$target_file"
    return
  fi

  local ts html_file
  ts=$(date +%Y%m%d-%H%M%S)
  html_file="$AI_PRIVATE_DIR/tasks/${COMMAND}-${ts}.html"
  mkdir -p "$AI_PRIVATE_DIR/tasks"

  awk '/^```html[[:space:]]*$/ { exit } { print }' <<< "$output" > "$target_file"
  awk '
    /^```html[[:space:]]*$/ { f = 1; next }
    f && /^```[[:space:]]*$/ { f = 0; next }
    f
  ' <<< "$output" > "$html_file"

  if [ -s "$html_file" ]; then
    echo "HTML task saved to $html_file"
  else
    rm -f "$html_file"
  fi
}

# Note about paths (used in prompts) - uses absolute path
PATH_NOTE="IMPORTANT: All output files must be written to $AI_PRIVATE_DIR/ (absolute path)."

# jq filter that turns cursor-agent's --output-format stream-json into readable live text.
# Only "assistant"/"thinking" events carrying timestamp_ms are true incremental deltas —
# cursor-agent re-emits a duplicate consolidated event (no timestamp_ms) after each one, which
# this filter skips to avoid printing every chunk twice.
# Points to a repo Skill instead of hand-rolling its instructions — claude-only,
# since Skills are a Claude Code concept that copilot/cursor don't share.
skill_hint() {
  [ "$PROVIDER" = "claude" ] && echo " $1"
}

cursor_stream_jq_filter() {
  cat <<'JQ'
if .type == "thinking" and .subtype == "delta" then .text
elif .type == "assistant" and (.timestamp_ms != null) then (.message.content[0].text // empty)
elif .type == "tool_call" and .subtype == "started" then
  "\n⚙ " + (((.tool_call | to_entries[0].value.args.description) // (.tool_call | to_entries[0].value.description) // "tool call")) + "\n"
elif .type == "result" then "\n"
else empty
end
JQ
}

# jq filter that turns claude's --output-format stream-json (with
# --include-partial-messages) into readable live text. content_block_delta
# events carry the true incremental chunks (text_delta / thinking_delta).
# The consolidated "assistant" event (one per turn) duplicates text already
# streamed via deltas, EXCEPT when its content is a tool_use block — that's
# the only place the tool's fully-resolved input (Bash's command, Read's
# file_path, ...) is available in one piece, so it's used here to show what
# each tool call is actually doing (e.g. "⚙ Bash: git diff --name-only...")
# instead of a bare repeated tool name, which otherwise looks like noise
# during the seconds-long gap while tools run and produce no text output.
# The "result" event carries final token/cost usage rather than conversation
# text, surfaced as a one-line summary instead of being dropped.
claude_stream_jq_filter() {
  cat <<'JQ'
if .type == "assistant" and (.message.content // [] | any(.type == "tool_use")) then
  (.message.content[] | select(.type == "tool_use") |
    "\n⚙ " + .name +
    (if .input.command then ": " + .input.command
     elif .input.file_path then ": " + .input.file_path
     elif .input.pattern then ": " + .input.pattern
     elif .input.description then ": " + .input.description
     else "" end) + "\n")
elif .type == "stream_event" and .event.type == "content_block_delta" and .event.delta.type == "text_delta" then .event.delta.text
elif .type == "stream_event" and .event.type == "content_block_delta" and .event.delta.type == "thinking_delta" then .event.delta.thinking
elif .type == "result" then
  "\n[tokens: in=" + (.usage.input_tokens // 0 | tostring) + " out=" + (.usage.output_tokens // 0 | tostring) +
  " cache_read=" + (.usage.cache_read_input_tokens // 0 | tostring) +
  " cost=$" + ((.total_cost_usd // 0) * 10000 | round / 10000 | tostring) + "]\n"
else empty
end
JQ
}

run_ai() {
  local input="$1"
  local default_model="${2:-}"
  local files_display="${3:-}"
  local prompt_no_static="${4:-$input}"
  local dynamic_cmds="${5:-}"

  # Use override if set, otherwise use default
  local internal_model="${MODEL_OVERRIDE:-$default_model}"
  # Translate model for the provider
  local resolved_model
  resolved_model=$(translate_model "$internal_model" "$PROVIDER")

  echo "═══════════════════════════════════════════════════════════════"
  echo "Provider : $PROVIDER"
  echo "Command  : $COMMAND"
  echo "Branch   : $(git branch --show-current)"
  if [ -n "$internal_model" ]; then
    if [ "$internal_model" != "$resolved_model" ]; then
      echo "Model    : $internal_model → $resolved_model"
    else
      echo "Model    : $resolved_model"
    fi
  else
    echo "Model    : (default)"
  fi
  echo "Dry-run  : $DRY_RUN"
  echo "Planning : $PLANNING_HTML"

  # See PLAN_MODE_COMMANDS above for which commands run read-only.
  local perm_flags=""
  local plan_mode=false
  is_plan_mode_command "$COMMAND" && plan_mode=true
  local capture_target=""
  [ "$plan_mode" = true ] && capture_target=$(capture_target_for_command "$COMMAND")
  local capture_label=""
  if [ "$capture_target" = "$PLANNING" ]; then
    capture_label="\$PLANNING"
  elif [ "$capture_target" = "$REVIEW" ]; then
    capture_label="\$REVIEW"
  fi
  case "$PROVIDER" in
    claude)  perm_flags=$([ "$plan_mode" = true ] && echo "--permission-mode plan" || echo "--dangerously-skip-permissions") ;;
    copilot) perm_flags=$([ "$plan_mode" = true ] && echo "--plan" || echo "--allow-all-tools --allow-all-paths") ;;
    cursor)  perm_flags=$([ "$plan_mode" = true ] && echo "--plan --trust" || echo "--force --trust") ;;
  esac
  echo "Plan mode: $plan_mode"
  echo "═══════════════════════════════════════════════════════════════"

  if [ "$DRY_RUN" = true ]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    PROVIDER COMMAND                           ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    local cmd_prefix=""
    if [ -n "$files_display" ]; then
      cmd_prefix="cat $files_display"
    fi
    if [ -n "$dynamic_cmds" ]; then
      if [ -n "$cmd_prefix" ]; then
        cmd_prefix="{ $cmd_prefix; $dynamic_cmds; }"
      else
        cmd_prefix="{ $dynamic_cmds; }"
      fi
    fi

    local tee_suffix=""
    if [ "$plan_mode" = true ] && [ -n "$capture_target" ] && [ "$PLANNING_HTML" = true ]; then
      tee_suffix=" (captured, split into $capture_label + an HTML task file via write_captured_output)"
    elif [ "$plan_mode" = true ] && [ -n "$capture_target" ]; then
      tee_suffix=" | tee $capture_label"
    elif [ "$plan_mode" = true ]; then
      tee_suffix=" (read-only plan mode, printed only — not saved to a file)"
    fi

    case "$PROVIDER" in
      copilot)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | copilot --model $resolved_model $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          else
            echo "$cmd_prefix | copilot $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "copilot --model $resolved_model $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          else
            echo "copilot $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          fi
        fi
        ;;
      claude)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | claude --print $perm_flags --output-format stream-json --include-partial-messages --verbose --model $resolved_model \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          else
            echo "$cmd_prefix | claude --print $perm_flags --output-format stream-json --include-partial-messages --verbose \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "claude --print $perm_flags --output-format stream-json --include-partial-messages --verbose --model $resolved_model \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          else
            echo "claude --print $perm_flags --output-format stream-json --include-partial-messages --verbose \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          fi
        fi
        ;;
      cursor)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --model $resolved_model --add-dir \$REPO_ROOT \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          else
            echo "$cmd_prefix | cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --add-dir \$REPO_ROOT \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --model $resolved_model --add-dir \$REPO_ROOT \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          else
            echo "cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --add-dir \$REPO_ROOT \"<PROMPT>\" | jq --unbuffered -r -j '<stream formatter>'$tee_suffix"
          fi
        fi
        ;;
    esac
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    <PROMPT> (without static context)          ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo "$prompt_no_static"
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "Prompt length: $(echo "$input" | wc -c | tr -d ' ') chars, $(echo "$input" | wc -l | tr -d ' ') lines"
    echo "═══════════════════════════════════════════════════════════════"
    return 0
  fi

  # Plan mode is structurally read-only — the model cannot call Write/Edit to
  # save its output file (or the HTML task file) itself (confirmed by
  # testing: it can only return its response as text). So when plan_mode is
  # on and there's a capture_target, bash saves that printed text instead of
  # asking the model to write a file it has no ability to write. Plain case:
  # streamed straight through `tee`. If an inline HTML task is also expected
  # (PLANNING_HTML=true), the output is captured first so
  # write_captured_output can split the HTML block out of it. Plan-mode
  # commands with no capture_target (explain; a --deep lens sub-pass) just
  # stream through like a normal command, since nothing needs to be saved.
  local cmd=()
  case "$PROVIDER" in
    copilot)
      cmd=(copilot)
      [ -n "$resolved_model" ] && cmd+=(--model "$resolved_model")
      cmd+=($perm_flags --silent --add-dir "$REPO_ROOT" -p "$input")
      if [ "$plan_mode" = true ] && [ -n "$capture_target" ] && [ "$PLANNING_HTML" = true ]; then
        local output
        output=$("${cmd[@]}")
        echo "$output"
        write_captured_output "$output" "$capture_target"
      elif [ "$plan_mode" = true ] && [ -n "$capture_target" ]; then
        "${cmd[@]}" | tee "$capture_target"
      else
        "${cmd[@]}"
      fi
      ;;
    claude)
      cmd=(claude --print)
      cmd+=($perm_flags --output-format stream-json --include-partial-messages --verbose)
      [ -n "$resolved_model" ] && cmd+=(--model "$resolved_model")
      cmd+=("$input")
      if [ "$plan_mode" = true ] && [ -n "$capture_target" ] && [ "$PLANNING_HTML" = true ]; then
        local output
        output=$("${cmd[@]}" | jq --unbuffered -r -j "$(claude_stream_jq_filter)")
        echo "$output"
        write_captured_output "$output" "$capture_target"
      elif [ "$plan_mode" = true ] && [ -n "$capture_target" ]; then
        "${cmd[@]}" | jq --unbuffered -r -j "$(claude_stream_jq_filter)" | tee "$capture_target"
      else
        "${cmd[@]}" | jq --unbuffered -r -j "$(claude_stream_jq_filter)"
      fi
      echo ""
      ;;
    cursor)
      cmd=(cursor-agent --print)
      cmd+=($perm_flags --output-format stream-json --stream-partial-output)
      [ -n "$resolved_model" ] && cmd+=(--model "$resolved_model")
      cmd+=(--add-dir "$REPO_ROOT" "$input")
      if [ "$plan_mode" = true ] && [ -n "$capture_target" ] && [ "$PLANNING_HTML" = true ]; then
        local output
        output=$("${cmd[@]}" | jq --unbuffered -r -j "$(cursor_stream_jq_filter)")
        echo "$output"
        write_captured_output "$output" "$capture_target"
      elif [ "$plan_mode" = true ] && [ -n "$capture_target" ]; then
        "${cmd[@]}" | jq --unbuffered -r -j "$(cursor_stream_jq_filter)" | tee "$capture_target"
      else
        "${cmd[@]}" | jq --unbuffered -r -j "$(cursor_stream_jq_filter)"
      fi
      echo ""
      ;;
    *)
      echo "Error: Unknown provider '$PROVIDER'"
      usage
      exit 1
      ;;
  esac
}

