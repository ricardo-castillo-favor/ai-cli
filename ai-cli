# ai-cli is a plain shell script and DB90 is an MCP tool — MCP tools are only
# reachable from inside an AI chat/agent session, not from a shell process,
# so this can't actually call DB90 itself. Instead it prints a ready-to-paste
# prompt so a Cursor/Claude Code chat in this repo can invoke DB90 on your
# behalf and refresh the standards ai-cli relies on (CLAUDE.md/docs/, Skills
# referenced by skill_hint(), the MCP servers 'suggestions' assumes, and the
# PR template 'pr' should follow).
sync_db90_hint() {
  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  echo "═══════════════════════════════════════════════════════════════"
  echo "DB90 sync reminder"
  echo "═══════════════════════════════════════════════════════════════"
  echo "ai-cli can't call the DB90 MCP directly — it's only reachable from"
  echo "inside an AI chat session, not from a shell script. Paste the block"
  echo "below into a Cursor/Claude Code chat in this repo:"
  echo "  $repo_root"
  echo ""
  cat <<'PROMPT'
Using the DB90 MCP:
1) Run `initialize_rules` (or `update_rules` if this repo already has one)
   for this project's detected profile, so CLAUDE.md/docs/ match the
   current company conventions for this stack.
2) Run `setup_agents` for this IDE, so any Skills that ai-cli hints at
   (e.g. security-review, update-playwright-mocks) are actually installed.
3) Run `setup_mcp_servers` for this project type, so the GitHub MCP server
   that `ai-cli ... suggestions` relies on is configured.
4) Run `download_pr_templates` for this org's platform (e.g. github), so
   `ai-cli ... pr` can match the company PR template instead of a generic
   Summary/Changes/Testing one.
Summarize what changed and what, if anything, needs manual follow-up.
PROMPT
  echo ""
  echo "Run this occasionally — new repo, new framework major version, or"
  echo "whenever ai-cli's output feels out of sync with current team"
  echo "conventions."
  echo "═══════════════════════════════════════════════════════════════"
}

if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

if [ "$1" = "sync-db90" ]; then
  sync_db90_hint
  exit 0
fi

# Parses --dry-run/--model/--planning off the front of "$@"; leftover args
# land in PARSED_REMAINING for the caller to `set --` back into position.
# Called twice below so flags work before or after the provider.
parse_global_flags() {
  while true; do
    case "${1:-}" in
      --dry-run|-d)
        DRY_RUN=true
        shift
        ;;
      --model|-m)
        shift
        MODEL_OVERRIDE="${1:-}"
        shift || true
        ;;
      --planning|-p)
        PLANNING_HTML=true
        shift
        ;;
      --yes|-y)
        CHAIN_YES=true
        shift
        ;;
      --deep)
        DEEP=true
        shift
        ;;
      *)
        break
        ;;
    esac
  done
  PARSED_REMAINING=("$@")
}

parse_global_flags "$@"
# ${arr[@]+"${arr[@]}"} instead of a plain "${PARSED_REMAINING[@]}": on
# bash 3.2 (macOS's default /bin/bash), expanding an empty array under
# `set -u` throws "unbound variable" instead of expanding to nothing —
# fixed in bash 4.4+, but this script has to keep working on the older one.
set -- ${PARSED_REMAINING[@]+"${PARSED_REMAINING[@]}"}

PROVIDER="${1:-}"
shift || true

parse_global_flags "$@"
set -- ${PARSED_REMAINING[@]+"${PARSED_REMAINING[@]}"}

COMMAND="${1:-}"
shift || true

KNOWN_COMMANDS=("audit" "commit" "debug" "explain" "feature" "fix" "lint" "playwright" "pr" "refactor" "review" "planning" "suggestions" "test" "types")

if [ -z "$COMMAND" ]; then
  usage
  exit 1
fi

# "chain" takes steps up to a literal "--", then everything after it is the
# shared prompt. The "--" is mandatory (not inferred from KNOWN_COMMANDS)
# because a prompt starting with a word that happens to also be a command
# name (e.g. "fix the login bug") would otherwise get silently swallowed as
# an extra step instead of treated as the prompt.
CHAIN_STEPS=()
if [ "$COMMAND" = "chain" ]; then
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
    if [[ ! " ${KNOWN_COMMANDS[*]} " =~ " ${1} " ]]; then
      echo "Error: '$1' is not a known command for 'chain'."
      echo "Known commands: ${KNOWN_COMMANDS[*]}"
      exit 1
    fi
    CHAIN_STEPS+=("$1")
    shift
  done
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  if [ "${#CHAIN_STEPS[@]}" -lt 2 ]; then
    echo "Error: 'chain' needs at least 2 known commands, separated from the"
    echo "prompt by --, e.g.:"
    echo "  ai-cli claude chain planning feature review -- \"your request\""
    exit 1
  fi
fi

PROMPT="$*"

if [ "$COMMAND" != "chain" ] && [[ ! " ${KNOWN_COMMANDS[*]} " =~ " ${COMMAND} " ]]; then
  PROMPT="$COMMAND $PROMPT"
  COMMAND="chat"
fi

if [ -z "${PROMPT// }" ]; then
  PROMPT="General $COMMAND request"
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)

if [ -z "$REPO_ROOT" ]; then
  echo "Error: Not inside a git repository"
  exit 1
fi

cd "$REPO_ROOT"

# Resolve the repo's actual default branch instead of assuming "master":
# 1) the remote's recorded HEAD (works even without a local branch checked
#    out for it), 2) a local/remote "main" or "master" branch that exists,
# 3) fall back to "master" if none of the above resolved anything (e.g. a
# repo with no commits yet).
detect_base_branch() {
  local branch
  branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  if [ -z "$branch" ]; then
    branch=$(git remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p')
  fi
  if [ -z "$branch" ]; then
    local candidate
    for candidate in main master; do
      if git show-ref --verify --quiet "refs/heads/$candidate" || git show-ref --verify --quiet "refs/remotes/origin/$candidate"; then
        branch="$candidate"
        break
      fi
    done
  fi
  echo "${branch:-master}"
}
BASE_BRANCH=$(detect_base_branch)

# Ensure .ai-private directory exists with proper permissions
AI_PRIVATE_DIR="$REPO_ROOT/.ai-private"
if [ ! -d "$AI_PRIVATE_DIR" ]; then
  mkdir -p "$AI_PRIVATE_DIR"
  chmod 755 "$AI_PRIVATE_DIR"
fi

