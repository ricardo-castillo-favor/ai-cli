}

if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

# Parses --dry-run/--model/--planning off the front of "$@"; leftover args
# land in PARSED_REMAINING for the caller to `set --` back into position.
# Called twice below so flags work before or after the provider.
parse_global_flags() {
  while true; do
    case "${1:-}" in
      --dry-run|-d)
        DRY_RUN=true
        shift
        ;;
      --model|-m)
        shift
        MODEL_OVERRIDE="${1:-}"
        shift || true
        ;;
      --planning|-p)
        PLANNING_HTML=true
        shift
        ;;
      --yes|-y)
        CHAIN_YES=true
        shift
        ;;
      --deep)
        DEEP=true
        shift
        ;;
      *)
        break
        ;;
    esac
  done
  PARSED_REMAINING=("$@")
}

parse_global_flags "$@"
set -- "${PARSED_REMAINING[@]}"

PROVIDER="${1:-}"
shift || true

parse_global_flags "$@"
set -- "${PARSED_REMAINING[@]}"

COMMAND="${1:-}"
shift || true

KNOWN_COMMANDS=("audit" "commit" "debug" "explain" "feature" "fix" "lint" "playwright" "pr" "refactor" "review" "planning" "suggestions" "test" "types")

if [ -z "$COMMAND" ]; then
  usage
  exit 1
fi

# "chain" takes steps up to a literal "--", then everything after it is the
# shared prompt. The "--" is mandatory (not inferred from KNOWN_COMMANDS)
# because a prompt starting with a word that happens to also be a command
# name (e.g. "fix the login bug") would otherwise get silently swallowed as
# an extra step instead of treated as the prompt.
CHAIN_STEPS=()
if [ "$COMMAND" = "chain" ]; then
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
    if [[ ! " ${KNOWN_COMMANDS[*]} " =~ " ${1} " ]]; then
      echo "Error: '$1' is not a known command for 'chain'."
      echo "Known commands: ${KNOWN_COMMANDS[*]}"
      exit 1
    fi
    CHAIN_STEPS+=("$1")
    shift
  done
  if [ "${1:-}" = "--" ]; then
    shift
  fi
  if [ "${#CHAIN_STEPS[@]}" -lt 2 ]; then
    echo "Error: 'chain' needs at least 2 known commands, separated from the"
    echo "prompt by --, e.g.:"
    echo "  ai-cli claude chain planning feature review -- \"your request\""
    exit 1
  fi
fi

PROMPT="$*"

if [ "$COMMAND" != "chain" ] && [[ ! " ${KNOWN_COMMANDS[*]} " =~ " ${COMMAND} " ]]; then
  PROMPT="$COMMAND $PROMPT"
  COMMAND="chat"
fi

if [ -z "${PROMPT// }" ]; then
  PROMPT="General $COMMAND request"
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)

if [ -z "$REPO_ROOT" ]; then
  echo "Error: Not inside a git repository"
  exit 1
fi

cd "$REPO_ROOT"

# Ensure .ai-private directory exists with proper permissions
AI_PRIVATE_DIR="$REPO_ROOT/.ai-private"
if [ ! -d "$AI_PRIVATE_DIR" ]; then
  mkdir -p "$AI_PRIVATE_DIR"
  chmod 755 "$AI_PRIVATE_DIR"
fi

BASE="$REPO_ROOT/CLAUDE.md"
DEBUG="$AI_PRIVATE_DIR/DEBUG.md"
REFACTOR="$AI_PRIVATE_DIR/REFACTOR.md"
REVIEW="$AI_PRIVATE_DIR/REVIEW.md"
PLANNING="$AI_PRIVATE_DIR/PLANNING.md"
BUG_HUNTING="$AI_PRIVATE_DIR/BUG-HUNTING.md"

require_files() {
  for file in "$@"; do
    if [ ! -f "$file" ]; then
      echo "Warning: Missing file $file (skipped)"
    fi
  done
}

existing_files() {
  for file in "$@"; do
    [ -f "$file" ] && echo "$file"
  done
}

# Reusable instruction for HTML task visualization
html_task_instruction() {
  if [ "$PLANNING_HTML" != "true" ]; then
    echo ""
    return
  fi
  local ts
  ts=$(date +%Y%m%d-%H%M%S)
  echo "Based on the above, create a clean, interactive, professional HTML/CSS/JS self-contained '${COMMAND}-${ts}.html' with modern styling (layout, colors, filters, charts). Save to $AI_PRIVATE_DIR/tasks/${COMMAND}-${ts}.html (create folder if needed)."
}

# Same as html_task_instruction, but for plan mode: the model can't write a
# file, so it emits the HTML inline as a fenced ```html code block and
# write_plan_output() (below) splits it out into its own file afterwards.
# Earlier version used a bare "###MARKER###" sentinel instead of a normal
# code fence — tested directly, a model asked to emit an arbitrary sentinel
# string with no framing read it as a prompt-injection attempt and refused.
# A ```html fence is a completely ordinary thing to ask for, so it doesn't
# trip that same instinct, and it's what write_plan_output now looks for.
html_task_instruction_inline() {
  if [ "$PLANNING_HTML" != "true" ]; then
    echo ""
    return
  fi
  echo "Also produce a clean, interactive, professional HTML/CSS/JS self-contained infographic of this plan (layout, colors, filters, charts). You have no access to write files in this pass, so output the complete HTML as the very last thing in your response, as a single fenced code block starting with \`\`\`html on its own line and ending with a closing \`\`\` on its own line, with nothing after it."
}

# Writes a plan-mode response to $PLANNING, splitting out an inline ```html
# fenced block (see html_task_instruction_inline) into its own timestamped
# file if present.
write_plan_output() {
  local output="$1"
  if ! grep -qE '^```html[[:space:]]*$' <<< "$output"; then
    echo "$output" > "$PLANNING"
    return
  fi

  local ts html_file
  ts=$(date +%Y%m%d-%H%M%S)
  html_file="$AI_PRIVATE_DIR/tasks/planning-${ts}.html"
  mkdir -p "$AI_PRIVATE_DIR/tasks"

  awk '/^```html[[:space:]]*$/ { exit } { print }' <<< "$output" > "$PLANNING"
  awk '
    /^```html[[:space:]]*$/ { f = 1; next }
    f && /^```[[:space:]]*$/ { f = 0; next }
    f
  ' <<< "$output" > "$html_file"

  if [ -s "$html_file" ]; then
    echo "HTML task saved to $html_file"
  else
    rm -f "$html_file"
  fi
}

# Note about paths (used in prompts) - uses absolute path
PATH_NOTE="IMPORTANT: All output files must be written to $AI_PRIVATE_DIR/ (absolute path)."

# jq filter that turns cursor-agent's --output-format stream-json into readable live text.
# Only "assistant"/"thinking" events carrying timestamp_ms are true incremental deltas —
# cursor-agent re-emits a duplicate consolidated event (no timestamp_ms) after each one, which
# this filter skips to avoid printing every chunk twice.
# Points to a repo Skill instead of hand-rolling its instructions — claude-only,
# since Skills are a Claude Code concept that copilot/cursor don't share.
skill_hint() {
  [ "$PROVIDER" = "claude" ] && echo " $1"
}

cursor_stream_jq_filter() {
  cat <<'JQ'
if .type == "thinking" and .subtype == "delta" then .text
elif .type == "assistant" and (.timestamp_ms != null) then (.message.content[0].text // empty)
elif .type == "tool_call" and .subtype == "started" then
  "\n⚙ " + (((.tool_call | to_entries[0].value.args.description) // (.tool_call | to_entries[0].value.description) // "tool call")) + "\n"
elif .type == "result" then "\n"
else empty
end
JQ
}

run_ai() {
  local input="$1"
  local default_model="${2:-}"
  local files_display="${3:-}"
  local prompt_no_static="${4:-$input}"
  local dynamic_cmds="${5:-}"

  # Use override if set, otherwise use default
  local internal_model="${MODEL_OVERRIDE:-$default_model}"
  # Translate model for the provider
  local resolved_model
  resolved_model=$(translate_model "$internal_model" "$PROVIDER")

  echo "═══════════════════════════════════════════════════════════════"
  echo "Provider : $PROVIDER"
  echo "Command  : $COMMAND"
  echo "Branch   : $(git branch --show-current)"
  if [ -n "$internal_model" ]; then
    if [ "$internal_model" != "$resolved_model" ]; then
      echo "Model    : $internal_model → $resolved_model"
    else
      echo "Model    : $resolved_model"
    fi
  else
    echo "Model    : (default)"
  fi
  echo "Dry-run  : $DRY_RUN"
  echo "Planning : $PLANNING_HTML"

  # The 'planning' command runs read-only in each provider's plan mode
  # instead of its normal skip-permissions/allow-all flags — those flags
  # were confirmed (by direct testing) to silently override plan mode and
  # let the model edit files anyway, so they must not be combined.
  local perm_flags=""
  local plan_mode=false
  [ "$COMMAND" = "planning" ] && plan_mode=true
  case "$PROVIDER" in
    claude)  perm_flags=$([ "$plan_mode" = true ] && echo "--permission-mode plan" || echo "--dangerously-skip-permissions") ;;
    copilot) perm_flags=$([ "$plan_mode" = true ] && echo "--plan" || echo "--allow-all-tools --allow-all-paths") ;;
    cursor)  perm_flags=$([ "$plan_mode" = true ] && echo "--plan --trust" || echo "--force --trust") ;;
  esac
  echo "Plan mode: $plan_mode"
  echo "═══════════════════════════════════════════════════════════════"

  if [ "$DRY_RUN" = true ]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    PROVIDER COMMAND                           ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    local cmd_prefix=""
    if [ -n "$files_display" ]; then
      cmd_prefix="cat $files_display"
    fi
    if [ -n "$dynamic_cmds" ]; then
      if [ -n "$cmd_prefix" ]; then
        cmd_prefix="{ $cmd_prefix; $dynamic_cmds; }"
      else
        cmd_prefix="{ $dynamic_cmds; }"
      fi
    fi

    local tee_suffix=""
    if [ "$plan_mode" = true ] && [ "$PLANNING_HTML" = true ]; then
      tee_suffix=" (captured, split into \$PLANNING + an HTML task file via write_plan_output)"
    elif [ "$plan_mode" = true ]; then
      tee_suffix=" | tee \$PLANNING"
    fi

    case "$PROVIDER" in
      copilot)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | copilot --model $resolved_model $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          else
            echo "$cmd_prefix | copilot $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "copilot --model $resolved_model $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          else
            echo "copilot $perm_flags --silent --add-dir \$REPO_ROOT -p \"<PROMPT>\"$tee_suffix"
          fi
        fi
        ;;
      claude)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | claude --print $perm_flags --model $resolved_model \"<PROMPT>\"$tee_suffix"
          else
            echo "$cmd_prefix | claude --print $perm_flags \"<PROMPT>\"$tee_suffix"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "claude --print $perm_flags --model $resolved_model \"<PROMPT>\"$tee_suffix"
          else
            echo "claude --print $perm_flags \"<PROMPT>\"$tee_suffix"
          fi
        fi
        ;;
      cursor)
        if [ -n "$cmd_prefix" ]; then
          if [ -n "$resolved_model" ]; then
            echo "$cmd_prefix | cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --model $resolved_model --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'$tee_suffix"
          else
            echo "$cmd_prefix | cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'$tee_suffix"
          fi
        else
          if [ -n "$resolved_model" ]; then
            echo "cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --model $resolved_model --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'$tee_suffix"
          else
            echo "cursor-agent --print $perm_flags --output-format stream-json --stream-partial-output --add-dir \$REPO_ROOT \"<PROMPT>\" | jq -r -j '<stream formatter>'$tee_suffix"
          fi
        fi
        ;;
    esac
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                    <PROMPT> (without static context)          ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo "$prompt_no_static"
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "Prompt length: $(echo "$input" | wc -c | tr -d ' ') chars, $(echo "$input" | wc -l | tr -d ' ') lines"
    echo "═══════════════════════════════════════════════════════════════"
    return 0
  fi

  # Plan mode is structurally read-only — the model cannot call Write/Edit to
  # save PLANNING.md (or the HTML task file) itself (confirmed by testing: it
  # can only return the plan as response text). So when plan_mode is on, bash
  # saves that printed text instead of asking the model to write a file it
  # has no ability to write. Plain case: streamed straight through `tee`. If
  # an inline HTML task is also expected (PLANNING_HTML=true), the output is
  # captured first so write_plan_output can split the HTML block out of it.
  local cmd=()
  case "$PROVIDER" in
    copilot)
      cmd=(copilot)
      [ -n "$resolved_model" ] && cmd+=(--model "$resolved_model")
      cmd+=($perm_flags --silent --add-dir "$REPO_ROOT" -p "$input")
      if [ "$plan_mode" = true ] && [ "$PLANNING_HTML" = true ]; then
        local output
        output=$("${cmd[@]}")
        echo "$output"
        write_plan_output "$output"
      elif [ "$plan_mode" = true ]; then
        "${cmd[@]}" | tee "$PLANNING"
      else
        "${cmd[@]}"
      fi
      ;;
    claude)
      cmd=(claude --print)
      cmd+=($perm_flags)
      [ -n "$resolved_model" ] && cmd+=(--model "$resolved_model")
      cmd+=("$input")
      if [ "$plan_mode" = true ] && [ "$PLANNING_HTML" = true ]; then
        local output
        output=$("${cmd[@]}")
        echo "$output"
        write_plan_output "$output"
      elif [ "$plan_mode" = true ]; then
        "${cmd[@]}" | tee "$PLANNING"
      else
        "${cmd[@]}"
      fi
      ;;
    cursor)
      cmd=(cursor-agent --print)
      cmd+=($perm_flags --output-format stream-json --stream-partial-output)
      [ -n "$resolved_model" ] && cmd+=(--model "$resolved_model")
      cmd+=(--add-dir "$REPO_ROOT" "$input")
      if [ "$plan_mode" = true ] && [ "$PLANNING_HTML" = true ]; then
        local output
        output=$("${cmd[@]}" | jq -r -j "$(cursor_stream_jq_filter)")
        echo "$output"
        write_plan_output "$output"
      elif [ "$plan_mode" = true ]; then
        "${cmd[@]}" | jq -r -j "$(cursor_stream_jq_filter)" | tee "$PLANNING"
      else
        "${cmd[@]}" | jq -r -j "$(cursor_stream_jq_filter)"
      fi
      echo ""
      ;;
    *)
      echo "Error: Unknown provider '$PROVIDER'"
      usage
      exit 1
      ;;
  esac
}

base_repo_context() {
  cat <<EOF

### BRANCH
$(git branch --show-current 2>/dev/null || true)

### REPO STATUS
$(git status --short 2>/dev/null || true)

### RECENT COMMITS
$(git log --oneline -8 2>/dev/null || true)

EOF
}

changed_files_context() {
  cat <<EOF

### CHANGED FILES AGAINST MASTER
$(git diff --name-only master...HEAD 2>/dev/null || true)

EOF
}

review_context() {
  cat <<EOF

$(base_repo_context)

$(changed_files_context)

EOF
}

feature_context() {
  cat <<EOF

$(base_repo_context)

$(changed_files_context)

### RELEVANT TREE
$(find . -maxdepth 3 \
  -not -path "./.git/*" \
  -not -path "./node_modules/*" \
  -not -path "./dist/*" \
  -not -path "./build/*" \
  -type f | sed 's#^\./##' | head -200)

EOF
}

refactor_context() {
  cat <<EOF

$(base_repo_context)

### STAGED FILES
$(git diff --cached --name-only 2>/dev/null || true)

### UNSTAGED FILES
$(git diff --name-only 2>/dev/null || true)

### CHANGED FILES AGAINST MASTER
$(git diff --name-only master...HEAD 2>/dev/null || true)

EOF
}

debug_context() {
  cat <<EOF

$(base_repo_context)

$(changed_files_context)

### BRANCH DIFF STATS
$(git diff --stat master...HEAD 2>/dev/null || true)

### PACKAGE SCRIPTS
$(node -e "try { const p=require('./package.json'); console.log(JSON.stringify(p.scripts,null,2)) } catch(e) {}" 2>/dev/null || true)

EOF
}

planning_context() {
  cat <<EOF

$(base_repo_context)

$(changed_files_context)

### BRANCH COMMITS
$(git log master..HEAD --oneline 2>/dev/null || true)

### MASTER RECENT
$(git log master --oneline -5 2>/dev/null || true)

### SOURCE FILES
$(find . -maxdepth 3 -type f \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' \) \
  -not -path "./.git/*" \
  -not -path "./node_modules/*" \
  -not -path "./dist/*" \
  -not -path "./build/*" \
  | sed 's#^\./##' | head -150)

### FULL TREE
$(find . -maxdepth 3 -type f \
  -not -path "./.git/*" \
  -not -path "*/node_modules/*" \
  -not -path "*/dist/*" \
  -not -path "*/.next/*" \
  -not -path "*/coverage/*" \
  -not -path "*/build/*" \
  | sed 's#^\./##' | head -100)

EOF
}

playwright_context() {
  cat <<EOF

$(base_repo_context)

$(changed_files_context)

### CHANGED TEST FILES
$(git diff --name-only master...HEAD 2>/dev/null | grep -E '\.(spec|test)\.(ts|js)$' || echo "No test files changed")

### PLAYWRIGHT CONFIG
$(cat playwright.config.ts 2>/dev/null | head -50 || echo "No playwright.config.ts found")

### PLAYWRIGHT TEST FILES
$(find . -path "*/playwright/*" -name "*.ts" -type f 2>/dev/null | head -30 || echo "No playwright tests found")

EOF
}

run() {
  local instruction="$1"
  local dynamic_context="$2"
  local model="${3:-}"
  local dynamic_cmds="${4:-}"
  shift 4 || true

  local files
  files=$(existing_files "$@")

  if [ -z "$files" ]; then
    echo "Error: No valid context files found"
    exit 1
  fi

  # Execute dynamic commands and capture output into context (live mode only)
  if [ -n "$dynamic_cmds" ] && [ "$DRY_RUN" = false ]; then
    local dynamic_cmd_output
    dynamic_cmd_output=$(eval "$dynamic_cmds" 2>&1 || true)
    if [ -n "$dynamic_cmd_output" ]; then
      dynamic_context="$dynamic_context

### COMMAND OUTPUT
\`\`\`
$dynamic_cmd_output
\`\`\`"
    fi
  fi

  # Get relative file paths for display
  local files_display
  files_display=$(echo "$files" | sed "s|$REPO_ROOT/||g" | tr '\n' ' ')

  local static_context
  static_context="$(cat $files 2>/dev/null || true)"

  local full_prompt="
  ### TASK
  $instruction

  ### STATIC CONTEXT
  $static_context

  ### DYNAMIC CONTEXT
  $dynamic_context

  ### USER REQUEST
  $PROMPT
  "

  # Prompt without static context (for dry-run display)
  local prompt_no_static="
  ### TASK
  $instruction

  ### DYNAMIC CONTEXT
  $dynamic_context

  ### USER REQUEST
  $PROMPT
  "

  run_ai "$full_prompt" "$model" "$files_display" "$prompt_no_static" "$dynamic_cmds"
}

# --deep: runs $instruction 3 times in parallel, each restricted to a
# different review lens, then a final pass that cross-checks all three
# against the actual diff and only writes findings that survive.
DEEP_LENSES=(
  "correctness and bugs"
  "security vulnerabilities (OWASP top 10, injection, auth, secrets)"
  "performance, code quality, and adherence to project conventions in docs/"
)

run_deep_review() {
  local instruction="$1"
  local dynamic_context="$2"
  local model="$3"
  local dynamic_cmds="$4"
  shift 4 || true

  local tmp_dir
  tmp_dir=$(mktemp -d "$AI_PRIVATE_DIR/.deep-review-XXXXXX")
  trap 'rm -rf "$tmp_dir"' RETURN

  echo "Deep review: running ${#DEEP_LENSES[@]} independent lenses in parallel..."

  local pids=()
  local i=0
  for lens in "${DEEP_LENSES[@]}"; do
    i=$((i + 1))
    (
      run "$instruction Focus this pass exclusively on: $lens. Do NOT modify, fix, or refactor any source file in this pass, even if the base instruction above says otherwise — report only. Return your findings as your response text only, do not write to REVIEW.md." \
        "$dynamic_context" "$model" "$dynamic_cmds" "$@" \
        > "$tmp_dir/lens-$i.md" 2>&1
    ) &
    pids+=("$!")
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done

  echo "Deep review: verifying findings against the diff and merging..."

  local combined=""
  for f in "$tmp_dir"/lens-*.md; do
    combined="$combined

### LENS: $(basename "$f")
$(cat "$f")"
  done

  run "Below are ${#DEEP_LENSES[@]} independent review passes over the same changes, each from a different angle, run blind to each other. 1) Cross-check every finding against the actual diff/code — discard anything that doesn't hold up on a second look, is speculative, or isn't actually present in the changes. 2) Merge duplicate findings reported by more than one lens into one. 3) Write ONLY the findings that survive this check to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite), grouped by severity, noting which lens(es) originally found each one. Do NOT modify, fix, or refactor any source file in this pass — report only; a plain 'fix' run afterwards is what applies the fixes. $PATH_NOTE" \
    "$combined" \
    "$model" \
    "" \
    "$@"
}

dispatch_command() {
case "$COMMAND" in
  chat)
    run_ai "$PROMPT"
    ;;

  audit)
    require_files "$BUG_HUNTING"
    audit_instruction="1) Review the current source-control changes (staged, unstaged, and against master) against the criteria in $AI_PRIVATE_DIR/BUG-HUNTING.md. 2) Identify bugs, inefficiencies, and unclear code introduced by these changes. 3) Avoid modifying or refactoring code external to this branch's changes against master. 5) Write a summary of findings and fixes applied to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite), grouped by severity."
    if [ "$DEEP" = true ]; then
      run_deep_review "$audit_instruction" \
        "$(refactor_context)" \
        "sonnet" \
        "" \
        "$BUG_HUNTING"
    else
      run "$audit_instruction" \
        "$(refactor_context)" \
        "sonnet" \
        "" \
        "$BUG_HUNTING"
    fi
    ;;

  debug)
    require_files "$BASE" "$DEBUG"
    run "1) Root cause analysis, 2) Minimal reproduction steps, 3) Smallest safe fix with code changes, 4) Regression tests to prevent recurrence, 5) Write findings to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite) with actionable suggestions grouped by severity. $(html_task_instruction) $PATH_NOTE. 6) Do NOT modify source files." \
      "$(debug_context)" \
      "opus" \
      "" \
      "$BASE" "$DEBUG"
    ;;

  feature)
    if [ ! -f "$PLANNING" ]; then
      echo "Error: $PLANNING not found."
      echo "Create it with your feature description. Note: this command now uses PLANNING.md (previously FEATURE.md)."
      exit 1
    fi
    require_files "$BASE"
    run "1) Implement the feature specified in $AI_PRIVATE_DIR/PLANNING.md. 2) Follow project conventions in $REPO_ROOT/docs. 3) Write clean, tested code matching existing patterns. 4) Create or update unit tests. $PATH_NOTE" \
      "$(feature_context)" \
      "" \
      "" \
      "$BASE" "$PLANNING"
    ;;

  refactor)
    require_files "$BASE" "$REVIEW"
    run "1) Apply the refactoring described in $AI_PRIVATE_DIR/REVIEW.md. 2) Preserve existing behavior while improving code quality. 3) Follow project conventions in $REPO_ROOT/docs. 4) Ensure all tests pass. 5) Create a refactoring summary inside $AI_PRIVATE_DIR/REFACTOR.md (if exists, overwrite). $PATH_NOTE" \
      "$(refactor_context)" \
      "" \
      "" \
      "$BASE" "$REVIEW"
    ;;

  review)
    require_files "$BASE" "$REVIEW"
    review_instruction="1) Review changed files against master. 2) Check for: bugs, style violations (per docs/), missing tests, performance issues, security concerns.$(skill_hint 'Use the security-review skill for the security-concerns dimension.') 3) Follow project conventions in $REPO_ROOT/docs and keep in mind $AI_PRIVATE_DIR/LEARNED.md doc about old reviews.  4) Write findings to $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite) with actionable suggestions grouped by severity. 5) $(html_task_instruction) $PATH_NOTE. 6) Do NOT modify source files."
    if [ "$DEEP" = true ]; then
      run_deep_review "$review_instruction" \
        "$(review_context)" \
        "" \
        "" \
        "$BASE" "$REVIEW"
    else
      run "$review_instruction" \
        "$(review_context)" \
        "" \
        "" \
        "$BASE" "$REVIEW"
    fi
    ;;

  planning)
    require_files "$BASE" "$PLANNING"
    run "1) Create an implementation plan from the custom prompt. 2) This is a read-only planning pass — you have no access to write files or run mutating tools, so don't attempt to; just present the complete plan directly in your response, it will be saved automatically. 3) Output: a) Architecture overview, b) Files to create/modify, c) Risks and mitigations, d) Implementation order, e) Test strategy.$(html_task_instruction_inline)" \
      "$(planning_context)" \
      "opus" \
      "" \
      "$BASE" "$PLANNING"
    ;;

  fix)
    require_files "$BASE" "$REVIEW"
    run "1) Fix the bugs and improvements from $AI_PRIVATE_DIR/REVIEW.md. 2) Follow project conventions in $REPO_ROOT/docs. 3) Avoid modifying or refactoring code external to this branch changes against master." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$BASE" "$REVIEW"
    ;;

  suggestions)
    require_files "$BASE"
    pr_info=$(gh pr view --json number,url,title 2>/dev/null || echo "No open PR found")
    run "1) Use github mcp to get the fix suggestions comments from this branch PR. 2) Create a fix plan based on the suggestions. 3) Write into $AI_PRIVATE_DIR/REVIEW.md (if exists, overwrite). 4) Ensure all tests pass. $PATH_NOTE" \
      "$(review_context)

### CURRENT PR
$pr_info" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  commit)
    require_files "$BASE"
    run "1) Generate a concise, semantic commit message for the staged changes. 2) Format: <type>(<scope>): <description>. 3) Types: feat, fix, refactor, docs, test, chore. 4) Return ONLY the commit message, nothing else." \
      "$(git diff --cached)" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  pr)
    require_files "$BASE"
    run "1) Generate a PR description for the changes in this branch against master. 2) Include: Summary, Changes made, Testing done. 3) Use markdown formatting." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  test)
    require_files "$BASE"
    run "1) Analyze the test output. 2) Focus on the root cause, not just making tests pass. 3) Suggest fixes. $PATH_NOTE" \
      "$(review_context)" \
      "sonnet" \
      "npm run test" \
      "$BASE"
    ;;

  types)
    require_files "$BASE"
    run "1) Fix TypeScript errors in the changed files. 2) Do not use 'any' - use \$TSFixMe with a comment if truly unavoidable. 3) Follow project conventions." \
      "$(review_context)" \
      "sonnet" \
      "" \
      "$BASE"
    ;;

  lint)
    require_files "$BASE"
    run "1) Analyze the lint output and fix ESLint and Prettier issues in the changed files. 2) Follow project style conventions." \
      "$(review_context)" \
      "sonnet" \
      "npm run check 2>&1 || true" \
      "$BASE"
    ;;

  playwright)
    require_files "$BASE"
    run "1) Analyze the Playwright E2E test output to identify failures introduced by this branch. 2) Compare changed files against master to determine if failures are related to branch changes. 3) For each failure: identify root cause, affected component, and suggest a fix. 4) If mocks are stale or API responses changed, note which HAR files need updating.$(skill_hint 'Use the update-playwright-mocks skill to actually update them, one test at a time.') 5) Write findings to $AI_PRIVATE_DIR/REVIEW.md with actionable fixes grouped by severity. $PATH_NOTE" \
      "$(playwright_context)" \
      "sonnet" \
      "npm run playwright 2>&1 || true" \
      "$BASE"
    ;;

  explain)
    require_files "$BASE"
    run "1) Explain the code, architecture, or pattern. 2) Be concise but thorough. 3) Include relevant file references." \
      "$(feature_context)" \
      "opus" \
      "" \
      "$BASE"
    ;;

  *)
    usage
    exit 1
    ;;
esac
}

if [ "${#CHAIN_STEPS[@]}" -gt 0 ]; then
  total="${#CHAIN_STEPS[@]}"
  for i in "${!CHAIN_STEPS[@]}"; do
    COMMAND="${CHAIN_STEPS[$i]}"
    echo ""
    echo "▶ Chain step $((i + 1))/$total: $COMMAND"
    dispatch_command
    is_last=$([ "$((i + 1))" -eq "$total" ] && echo true || echo false)
    if [ "$CHAIN_YES" != true ] && [ "$is_last" != true ] && [ "$DRY_RUN" = false ]; then
      read -r -p "Continue to next step ($((i + 2))/$total: ${CHAIN_STEPS[$((i + 1))]})? [y/N] " reply
      if [[ ! "$reply" =~ ^[Yy]$ ]]; then
        echo "Chain stopped by user after '$COMMAND'."
        exit 0
      fi
    fi
  done
else
  dispatch_command
fi